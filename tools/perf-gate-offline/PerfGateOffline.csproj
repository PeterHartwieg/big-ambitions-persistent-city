    <Compile Include="../../tools/economy-interventions/InterventionArms.cs" />
    <Compile Include="../../tools/economy-interventions/SelfChecks.cs" />
    <Compile Include="../../tools/movement-equivalence/MovementFixture.cs" />
    <Compile Include="../../tools/movement-equivalence/PresentationDriver.cs" />
