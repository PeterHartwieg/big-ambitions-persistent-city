<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SourceRoot Condition="'$(SourceRoot)' == ''">../..</SourceRoot>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SourceRoot)/Core/*.cs" />
    <Compile Include="$(SourceRoot)/Persistence/*.cs" />
    <Compile Include="../save-contract-regression/EconomyScenario.cs" />
    <Compile Include="Program.cs" /><Compile Include="Integrated.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
  </ItemGroup>
</Project>
