<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>9</LangVersion>
    <DefineConstants>$(DefineConstants);MULTIMODAL_REGRESSION</DefineConstants>
    <SourceRoot Condition="'$(SourceRoot)' == ''">../..</SourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SourceRoot)/Core/*.cs" />
    <Compile Include="$(SourceRoot)/Compatibility/*.cs" />
    <Compile Include="$(SourceRoot)/Runtime/MultimodalRoutes.cs" />
    <Compile Include="$(SourceRoot)/Runtime/RoadRoutes.cs" />
    <Compile Include="$(SourceRoot)/Runtime/TrafficRoadNetwork.cs" />
    <Compile Include="$(SourceRoot)/Runtime/NativeRoadSpeeds.cs" />
    <Compile Include="../road-handoff-regression/NativeStubs.cs" />
    <Compile Include="../road-handoff-regression/UnityStubs.cs" />
    <Compile Include="../road-ceiling-regression/MultimodalStubs.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
