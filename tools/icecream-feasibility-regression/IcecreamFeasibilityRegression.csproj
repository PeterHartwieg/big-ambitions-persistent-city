<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Core/PersistentCity.Core.csproj" />
    <Compile Include="../../Runtime/DirectStockShowcaseReader.cs" />
    <Compile Include="../../Runtime/DonutFeasibilityReader.cs" />
    <Compile Include="../../Runtime/CupcakeFeasibilityReader.cs" />
    <Compile Include="../../Runtime/SaladFeasibilityReader.cs" />
    <Compile Include="../../Runtime/IcecreamFeasibilityReader.cs" />
  </ItemGroup>
  <Target Name="ReusePinnedCases" BeforeTargets="CoreCompile">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)/generate_cases.py&quot; &quot;$(MSBuildProjectDirectory)/$(IntermediateOutputPath)Program.Generated.cs&quot;" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)Program.Generated.cs" /></ItemGroup>
  </Target>
</Project>
