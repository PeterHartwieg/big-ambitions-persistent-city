<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Core/PersistentCity.Core.csproj" />
    <Compile Include="obj/NativeDoubles.cs" />
    <Compile Include="../../Runtime/LoadedCatalogueEligibilityReader.cs" />
    <Compile Include="../../Runtime/LoadedCatalogueLifecycleMembers.cs" />
    <Compile Include="../../Runtime/DirectStockShowcaseReader.cs" />
    <Compile Include="../../Runtime/*FeasibilityReader.cs" />
    <Compile Include="../../Runtime/RemainingBatchFeasibilityReaders.cs" />
  </ItemGroup>
  <Target Name="GenerateNativeDoubles" BeforeTargets="BeforeCompile">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)/generate_doubles.py&quot; &quot;$(MSBuildProjectDirectory)/obj/NativeDoubles.cs&quot;" />
  </Target>
</Project>
