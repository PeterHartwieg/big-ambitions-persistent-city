<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Tool projects that live under tests/ (X5): the test project compiles their shared sources, not their entry points or build output. -->
    <Compile Remove="economy-interventions/**;movement-equivalence/**;capability-matrix/**" />
    <Compile Include="economy-interventions/EconomyFixture.cs;economy-interventions/InterventionInputs.cs;economy-interventions/EconomyRun.cs;economy-interventions/EconomyMetrics.cs;economy-interventions/InterventionArms.cs;economy-interventions/SelfChecks.cs" />
    <Compile Include="movement-equivalence/MovementFixture.cs;movement-equivalence/PresentationDriver.cs;movement-equivalence/MovementRun.cs;movement-equivalence/MovementArms.cs;movement-equivalence/Equivalence.cs;movement-equivalence/SelfChecks.cs;movement-equivalence/HoldReplay.cs" />
    <Compile Include="capability-matrix/CapabilityMatrix.cs" />
    <Compile Include="../Runtime/DecisionSupplyImage.cs" Link="DecisionSupplyImage.cs" />
    <Compile Include="../Runtime/FoodContractStamps.cs" Link="FoodContractStamps.cs" />
    <Compile Include="../Runtime/FoodContractHooks.cs" Link="FoodContractHooks.cs" />
    <Compile Include="../Runtime/OrdinaryOwnershipIndex.cs" Link="OrdinaryOwnershipIndex.cs" />
    <Compile Include="../Runtime/DwellSpots.cs" Link="DwellSpots.cs" />
    <Compile Include="../Runtime/PhysicalPopulation.cs" Link="PhysicalPopulation.cs" />
    <Compile Include="../Runtime/PhysicalPopulation.Following.cs" Link="PhysicalPopulation.Following.cs" />
    <Compile Include="../Runtime/PhysicalPopulation.Queues.cs" Link="PhysicalPopulation.Queues.cs" />
    <Compile Include="../Runtime/PhysicalPopulation.Selection.cs" Link="PhysicalPopulation.Selection.cs" />
    <Compile Include="../Runtime/PlayerContact.cs" Link="PlayerContact.cs" />
    <Compile Include="../Runtime/FoodMarkets.cs" Link="FoodMarkets.cs" />
    <Compile Include="../Runtime/StreetFoodVendorMarket.cs" Link="StreetFoodVendorMarket.cs" />
    <Compile Include="../Runtime/PrototypeSettings.cs" Link="PrototypeSettings.cs" />
    <Compile Include="../Runtime/FoodProductOverrideSettings.cs" Link="FoodProductOverrideSettings.cs" />
    <Compile Include="../Runtime/InteriorGuardSettings.cs" Link="InteriorGuardSettings.cs" />
    <Compile Include="../Runtime/InteriorViewState.cs" Link="InteriorViewState.cs" />
    <Compile Include="../Runtime/AudienceGeometryCache.cs" Link="AudienceGeometryCache.cs" />
    <Compile Include="../Runtime/StaticSceneMemory.cs" Link="StaticSceneMemory.cs" />
    <Compile Include="../Runtime/NativeCampaignReader.cs" Link="NativeCampaignReader.cs" />
    <Compile Include="../Runtime/ResearchAgencyMenu.cs" Link="ResearchAgencyMenu.cs" />
    <Compile Include="../Runtime/ResearchReportText.cs" Link="ResearchReportText.cs" />
    <Compile Include="../Runtime/FoodReceiptEvidence.cs" Link="FoodReceiptEvidence.cs" />
    <None Update="ReaderCorpus/**/*.json" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <ProjectReference Include="../Core/PersistentCity.Core.csproj" />
    <ProjectReference Include="../Persistence/PersistentCity.Persistence.csproj" />
    <ProjectReference Include="../Compatibility/PersistentCity.Compatibility.csproj" />
  </ItemGroup>
</Project>
